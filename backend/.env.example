# Copy to .env and change the values. Never commit .env.
PORT=3000
# Separate local/test database only. Never point tests at a shared or production database.
DATABASE_URL=postgres://taskmanager:taskmanager_local_only@localhost:5432/taskmanager
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-local-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Comma-separated list of browser origins allowed by CORS (empty = none; mobile apps do not need CORS)
CORS_ORIGINS=
