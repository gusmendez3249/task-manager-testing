{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "Task Manager REST API (Express + PostgreSQL + JWT refresh tokens) for the application-testing tutorial",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:memory": "node src/server.js --memory",
    "migrate": "node src/db/migrate.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:unit": "jest tests/unit",
    "test:api": "jest --runInBand tests/api"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
